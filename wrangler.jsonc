    "NUXT_PUBLIC_API_BASE": "/api/proxy",
    "NUXT_PUBLIC_BACKEND_BASE": "https://api.kimvannak.store",
    "NUXT_PUBLIC_APP_NAME": "Kim Vannak Store — Stock Manager"
  }
}

